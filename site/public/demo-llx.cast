[0.0, "o", "\u001b[?2026h\u001b[4A\r\u001b[J\u001b[32m• \u001b[0m\u001b[1mPatched\u001b[0m\u001b[1m \u001b[0mstats.py\r\n\u001b[2m  └ \u001b[0m\u001b[2m(+1 -1 lines)\u001b[0m\r\n\u001b[2m     12  12 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    middle = len(ordered) // 2\u001b[0m\r\n\u001b[2m     13  13 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    if len(ordered) % 2:\u001b[0m\r\n\u001b[2m     14  14 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m        return ordered[middle]\u001b[0m\r\n\u001b[2m     15     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    return ordered[middle]\u001b[0m\r\n\u001b[2m         15 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\n\r\n\u001b[36m⠸\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (6s · esc stop)\u001b[0m\r\n\r\n\u001b[1m❯ \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\n\u001b[2m  bypass mode · shift+tab to cycle                          10.7k in · 93% cached · 330 out · $0.000\u001b[0m\u001b[1A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
