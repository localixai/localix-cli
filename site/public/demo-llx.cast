[0.0, "o", "\u001b[2m  └ \u001b[0m\u001b[2m M stats.py\u001b[0m\r\n\u001b[2m    \u001b[0m\u001b[2mtotal 16\u001b[0m\r\n\u001b[2m    \u001b[0m\u001b[2m… +2 lines\u001b[0m\r\n\u001b[2m    \u001b[0m\u001b[2mdrwxr-xr-x@ 12 rustamsaryev  wheel  384 Oct 29 13:23 .git\u001b[0m\r\n\u001b[2m    \u001b[0m\u001b[2m-rw-r--r--@  1 rustamsaryev  wheel  419 Oct 29 13:23 stats.py\u001b[0m\r\n\u001b[2m    \u001b[0m\u001b[2m-rw-r--r--@  1 rustamsaryev  wheel  484 Oct 23 10:24 test_stats.py\u001b[0m\r\n"]
[0.003, "o", "\r\n\u001b[32m• \u001b[0m\u001b[1mRan\u001b[0m\u001b[1m \u001b[0mpwd && rg --files -g 'AGENTS.md' -g 'CLAUDE.md' -g 'package.json' -g 'pyproject.toml' -g\r\n\u001b[2m  │ \u001b[0m'pytest.ini' -g 'tox.ini' -g 'Makefile' -g 'justfile' -g 'Cargo.toml' -g 'go.mod' -g 'Gemfile'\r\n\u001b[2m  │ \u001b[0m-g 'composer.json' -g 'README*' | sort (in /private/tmp/demo/stats)\r\n"]
