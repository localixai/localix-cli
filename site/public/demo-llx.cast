[0.014, "o", "\u001b[?2026h\u001b[3A\r\u001b[J\r\r\n\u2022 My edit put the averaging in the odd branch, which is backwards. Fixing the function body so odd\r\r\n  counts return the middle value and even counts average the two middle values.\r\r\n\r\r\n\u001b[36m\u280b\u001b[0m \u001b[1mEditing\u001b[0m\u001b[1m \u001b[0mstats.py\r\r\n\r\r\n\u001b[36m\u2834\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (6s \u00b7 esc to interrupt)\u001b[0m\r\r\n\r\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\r\n\u001b[2m  bypass mode \u00b7 shift+tab to cycle                          25.7k in \u00b7 63% cached \u00b7 892 out \u00b7 $0.002\u001b[0m\u001b[1A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
[0.0, "o", "\u001b[?2026h\u001b[4A\r\u001b[J\u001b[32m\u2022 \u001b[0m\u001b[1mEdited\u001b[0m\u001b[1m \u001b[0mstats.py\r\r\n\u001b[2m  \u2514 \u001b[0m\u001b[2m(+2 -1 lines)\u001b[0m\r\r\n\u001b[2m     11  11 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    ordered = sorted(values)\u001b[0m\r\r\n\u001b[2m     12  12 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    middle = len(ordered) // 2\u001b[0m\r\r\n\u001b[2m     13  13 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    if len(ordered) % 2:\u001b[0m\r\r\n\u001b[2m     14     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m        return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\r\n\u001b[2m         14 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m        return ordered[middle]\u001b[0m\r\r\n\u001b[2m         15 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\r\n\r\r\n\u001b[36m\u280b\u001b[0m \u001b[1mRunning\u001b[0m\u001b[1m \u001b[0mcat stats.py && python3 -m unittest -v test_stats 2>&1 | tail -12; git diff --stat\r\r\n\r\r\n\u001b[36m\u2834\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (6s \u00b7 esc to interrupt)\u001b[0m\r\r\n\r\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\r\n\u001b[2m  bypass mode \u00b7 shift+tab to cycle                          25.7k in \u00b7 63% cached \u00b7 892 out \u00b7 $0.002\u001b[0m\u001b[1A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
[0.06, "o", "\u001b[?2026h\u001b[5A\r\u001b[J\r\r\n\u001b[32m\u2022 \u001b[0m\u001b[1mRan\u001b[0m\u001b[1m \u001b[0mcat stats.py && python3 -m unittest -v test_stats 2>&1 | tail -12; git diff --stat\r\r\n\u001b[2m  \u2514 \u001b[0m\u001b[2m\"\"\"Small statistics helpers.\"\"\"\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mdef mean(values):\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m\u2026 +15 lines\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mOK\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m stats.py | 2 +-\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m 1 file changed, 1 insertion(+), 1 deletion(-)\u001b[0m\r\r\n\r\r\n\u001b[36m\u2826\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (6s \u00b7 esc to interrupt)\u001b[0m\r\r\n\r\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\r\n\u001b[2m  bypass mode \u00b7 shift+tab to cycle                          25.7k in \u00b7 63% cached \u00b7 892 out \u00b7 $0.002\u001b[0m\u001b[1A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
