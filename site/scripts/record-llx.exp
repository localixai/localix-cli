# The landing's demo, in the folder given (a copy of evals/fixtures/fix-test, whose median tests
# fail, with ship.json committed): a session picks its provider and model with /model, switches
# to bypass with Shift+Tab and hands a task to two agents; then, from the shell as CI calls it,
# `llx exec --schema` reads the diff and answers with data. The session
# redraws in place, so it is waited for by time and by its end line. See RECORDING.md.
set timeout 300
set send_human {.05 .1 1 .03 .2}
proc wait {n} { expect -timeout $n eof {} timeout {} }
proc prompt {n} { expect -timeout $n -re {stats.*\$ $} {} timeout {} }
proc keys {text} { send -h $text }
cd [lindex $argv 0]
spawn zsh -f
wait 1
send "PS1='%F{8}~/stats%f \$ '; unsetopt prompt_sp; clear\r"
prompt 5
wait 1
keys "llx"
send "\r"
wait 3
keys "/model"
wait 1
send "\r"
wait 3
send "\t"
wait 2
send "\t"
wait 2
send "\t"
wait 2
keys "terra"
wait 2
send "\033\[D"
wait 2
send "\r"
wait 3
send "\033\[Z"
wait 1
send "\033\[Z"
wait 2
keys "Start two agents at once: one finds why the median tests fail, one checks mean() on an empty list. Then fix stats.py, not the tests."
wait 1
send "\r"
expect -timeout 240 "Worked for" {} timeout {}
# Done once the screen is quiet: the spinner and the agents' rows draw while anything works.
expect -timeout 5 -re {.+} {exp_continue} timeout {}
send "\x04"
prompt 10
wait 1
keys "git diff | llx exec -y --deny edit --schema @ship.json \"Safe to ship? Which bump?\""
send "\r"
prompt 180
wait 2
send "\x04"
wait 2
