[0.046, "o", "\r\r\n\u001b[32m\u2022 \u001b[0m\u001b[1mRan\u001b[0m\u001b[1m \u001b[0mpython3 -m unittest -v\r\r\n\u001b[2m  \u2514 \u001b[0m\u001b[2mtest_mean (test_stats.MeanTest) ... ok\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mtest_even_count (test_stats.MedianTest) ... ok\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m\u2026 +2 lines\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m----------------------------------------------------------------------\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mRan 4 tests in 0.000s\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mOK\u001b[0m\r\r\n"]
